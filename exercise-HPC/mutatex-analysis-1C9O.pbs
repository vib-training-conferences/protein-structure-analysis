APPTAINER_CACHEDIR=/tmp/ \
APPTAINER_TMPDIR=/tmp/ \
apptainer exec $VSC_SCRATCH_PROJECTS_BASE/2026_400/20261125-Exploring-protein-structures/alexb/mutatex-v1.sif /opt/conda/envs/mutatex/bin/ddg2heatmap \
